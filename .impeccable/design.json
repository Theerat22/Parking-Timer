  "narrative": {
    "northStar": "Quiet parking utility",
    "overview": "Parking Timer adapts the user-pinned Figma screen 2:89 in file 2DI44d3YnJjiyhJCdxj4Aa to parking tasks; it does not reproduce the scam product. This authority supersedes unrelated concept directions. The interface is quiet, concise, and practical: white space, plum ink, rose actions, and soft semantic surfaces support Thai reading and quick operation.\n\nThe implemented world uses IBM Plex Sans with its Thai companion, Lucide outlines, gently rounded controls, and flat separation. Light and dark themes preserve the same semantic roles. No gradients, emoji, or decorative imagery are part of this system.",
    "keyCharacteristics": [
      "Concise Thai copy and legible bilingual typography.",
      "Rose actions, green allowance states, and amber warnings.",
      "Flat surfaces, rounded controls, and tabular time and money."
    ],
    "rules": [
      {
        "name": "The Semantic Pair Rule",
        "body": "Keep foreground and soft-background roles paired when switching themes; use the matching `dark-` values rather than reusing light colors.",
        "section": "colors"
      },
      {
        "name": "The Stable Numbers Rule",
        "body": "Use tabular numerals for elapsed time, costs, history amounts, and summary values so changing digits do not shift alignment.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do use the semantic CSS variables so light and dark themes stay paired.",
      "Do use tabular numerals for time and money, and Lucide SVG icons.",
      "Do preserve the responsive mobile content inset and concise Thai labels.",
      "Do show text alongside semantic color and retain keyboard focus."
    ],
    "donts": [
      "Don't use gradients, emoji, or decorative imagery.",
      "Don't invent parking records to fill a live empty state.",
      "Don't introduce an unrelated visual identity in place of the pinned Figma authority."
    ]
  }
}
